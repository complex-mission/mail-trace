# 监听地址
LISTEN=127.0.0.1:9013

# 站点地址：写进 canonical / sitemap / OG / llms.txt。
# 自建部署务必改成自己的域名 —— 页面里的 canonical / og:url 会跟着一起替换，
# 不改的话等于对搜索引擎声明「本站是原站的副本」。
SITE_URL=https://mail-trace.complexmission.com

# Redis 限流（留空则不限流）。公网部署强烈建议开启。
# REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m

# 反向代理所在网段，逗号分隔，接受 CIDR 或单个 IP。
# 不配置时限流一律按 TCP 源地址计数 —— 在 nginx 后面这会让所有用户共用一个桶，
# 等于没限流。配置后才会采信代理传来的 X-Forwarded-For / X-Real-IP。
# （无条件相信这两个头同样不行：随手伪造一个就能换一个新桶。）
# MAIL_TRACE_TRUSTED_PROXIES=127.0.0.1,::1

# 同时进行的诊断数上限。一次完整诊断会开一条 SMTP 会话外加上百次 DNS 查询，
# 超出后新请求直接返回 503。设为 0 表示不限制。
MAX_CONCURRENT=32

# DNS 解析器，逗号分隔，可省略 :53。留空用内置默认值（223.5.5.5 + 1.1.1.1）。
#
# 为什么默认要掺一个境外解析器：国内公共 DNS 对大 TXT RRset 会静默丢记录。
# 实测同一个 github.com 连查三次，223.5.5.5 返回 14~18 条不等且从不含 SPF，
# 114DNS 只返回 6 条、百度 3 条，而 1.1.1.1 / 8.8.8.8 / 9.9.9.9 稳定返回全部 24 条。
# 少了 SPF 这一条，工具会把一个配置完全正确的域名判成四家收件方全线不合格。
# SPF / DMARC 走并发并集查询，所以第二台解析器不拖慢速度，被墙时也只是退回残缺结果。
#
# 另外：Spamhaus 等黑名单会拒绝来自公共 DNS 的查询（返回 127.255.255.x），
# 想要可信的 DNSBL 结论，这里必须指向自建的递归解析器。
# MAIL_TRACE_DNS=127.0.0.1:53

# 收到退出信号后，留给进行中诊断的收尾时间。
# 必须与进程管理器的停止超时对齐：supervisor 的 stopwaitsecs 默认 10 秒，
# systemd 的 TimeoutStopSec 默认 90 秒——管理器先超时的话，优雅退出就走不完。
SHUTDOWN_GRACE=90s

# 仅内网自部署时才开启：允许诊断私有/保留地址段的邮件服务器，并放开端口白名单。
# 公网部署切勿开启 —— 那会让本服务变成对外的内网端口扫描器。
# 同时会把「信道未加密时中止认证」降级为警告，以便测试无 TLS 的内网邮件服务器。
# MAIL_TRACE_ALLOW_PRIVATE=1
