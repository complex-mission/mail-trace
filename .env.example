# Listen address
LISTEN=127.0.0.1:9013

# Site address, written into canonical / sitemap / OG / llms.txt.
# Change this when self-hosting: the page's canonical and og:url are rewritten
# from it at startup, and leaving it as-is declares your copy a duplicate of
# the upstream site to search engines.
SITE_URL=https://mail-trace.complexmission.com

# Redis rate limiting (empty = no rate limiting). Strongly recommended in public.
# REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m

# Reverse-proxy ranges, comma separated, CIDR or single IP.
# Left empty, rate limiting counts the TCP source address — behind nginx that
# makes every visitor share one bucket, which is the same as no rate limiting.
# Only once this is set are X-Forwarded-For / X-Real-IP believed.
# (Trusting those headers unconditionally is just as wrong: anyone can forge
# one and get a fresh bucket.)
# MAIL_TRACE_TRUSTED_PROXIES=127.0.0.1,::1

# Cap on concurrent diagnostics. Each full run opens an SMTP session plus a few
# hundred DNS queries; requests beyond the cap get 503. Set 0 to disable.
MAX_CONCURRENT=32

# Ports the diagnostic may connect to, comma separated.
# The allowlist is what stops this service being usable as a port scanner: without
# it, anyone could point it at arbitrary host:port pairs and read back the banner.
# The default covers the ports mail actually uses - 994 is not a typo, it is the
# SSL port NetEase documents for 163/126 alongside 465. Widen it if you run a mail
# server on a non-standard port.
# MAIL_TRACE_ALLOWED_PORTS=25,465,587,994,2525

# DNS resolvers, comma separated, ":53" optional.
# Empty uses the built-in default (223.5.5.5 + 1.1.1.1).
#
# Why the default mixes in a non-Chinese resolver: public resolvers in China
# silently drop records from large TXT RRsets. Measured on the same github.com,
# three queries each, 223.5.5.5 returned 14-18 records and never the SPF one,
# 114DNS returned 6 and Baidu 3, while 1.1.1.1 / 8.8.8.8 / 9.9.9.9 each returned
# all 24 every time. Lose that one record and the tool declares a perfectly
# configured domain unfit for all four receiver families.
# SPF and DMARC query every resolver concurrently and merge the results, so the
# second resolver costs no time; if it is unreachable you simply fall back to
# the partial answer.
#
# Also: blocklists such as Spamhaus refuse queries from public resolvers
# (returning 127.255.255.x). For a trustworthy DNSBL verdict this has to point
# at your own recursive resolver.
# MAIL_TRACE_DNS=127.0.0.1:53

# How long in-flight diagnostics may finish after a stop signal.
# Match your process manager's timeout: supervisor kills at stopwaitsecs
# (default 10s) and systemd at TimeoutStopSec (default 90s) — whichever fires
# first wins, and a shorter one means the graceful path never completes.
SHUTDOWN_GRACE=90s

# Internal self-hosting only: allows diagnosing mail servers on private and
# reserved ranges, and lifts the port allowlist.
# Never enable this on a public deployment — it turns the service into an
# outbound port scanner.
# It also downgrades "abort authentication on an unencrypted channel" to a
# warning, so internal test servers without TLS remain usable.
# MAIL_TRACE_ALLOW_PRIVATE=1
