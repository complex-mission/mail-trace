# 监听地址
LISTEN=127.0.0.1:9013

# 站点地址：写进 canonical / sitemap / OG / llms.txt
SITE_URL=https://mail-trace.complexmission.com

# Redis 限流（留空则不限流）。公网部署强烈建议开启。
# REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m

# 仅内网自部署时才开启：允许诊断私有/保留地址段的邮件服务器，并放开端口白名单。
# 公网部署切勿开启 —— 那会让本服务变成对外的内网端口扫描器。
# MAIL_TRACE_ALLOW_PRIVATE=1
